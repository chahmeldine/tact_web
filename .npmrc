# pnpm 10 : les scripts de lifecycle (postinstall…) sont désactivés par défaut (sécurité).
# Autoriser explicitement les paquets de confiance qui en ont besoin via :
#   pnpm approve-builds
# ou en listant ici les paquets autorisés (exemple, à ajuster selon les deps réelles) :
# onlyBuiltDependencies[]=esbuild
# onlyBuiltDependencies[]=@nestjs/core

# Strictesse des peer deps (recommandé en monorepo)
strict-peer-dependencies=false
auto-install-peers=true
